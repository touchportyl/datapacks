    {
      "match": "function harvester:compatibility/setdamage-*",
      "loads": "1.17..26.2",
      "why": "/item arrived in 1.17; these modifiers do not load on 26.3"
    },
    {
      "match": "item_modifier harvester:26.3/*",
      "loads": "26.3.."
    },
    {
      "match": "item_modifier harvester:*",
      "loads": "1.17..26.2",
      "why": "loot function format before 26.3"
    },
    {
      "match": "predicate harvester:26.3/*",
      "loads": "26.3.."
    },
    {
      "match": "predicate harvester:*",
      "loads": "..26.2",
      "why": "predicate format before 26.3"
    },
    {
      "match": "advancement harvester:a_better_harvester",
      "loads": "never",
      "why": "its parent tinkererscraft:root_skills comes from Tinkerer's Craft, which the test world does not have"
    }
